rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas Seguras para Producción: permite lectura pública pero bloquea escritura
    match /movies/{movie} {
      allow read: if true;
      allow write: if false; 
    }
    match /series/{serie} {
      allow read: if true;
      allow write: if false;
    }

    // Permitir que cada usuario lea y escriba su propia información
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Regla por defecto: bloquea todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
