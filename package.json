{
  "name": "streaming-sntx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:genres": "node scripts/migrate-genre-labels.mjs",
    "ingest:tmdb": "node scripts/ingest-tmdb.mjs",
