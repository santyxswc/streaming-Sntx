    "ingest:tmdb:series:full": "cross-env TMDB_INGEST_FULL=1 TMDB_INGEST_TYPE=series node scripts/ingest-tmdb.mjs",
    "ingest:tmdb:movie:es:full": "cross-env TMDB_INGEST_FULL=1 TMDB_INGEST_TYPE=movie TMDB_INGEST_ORIGINAL_LANGUAGE=es node scripts/ingest-tmdb.mjs",
    "ingest:tmdb:series:es:full": "cross-env TMDB_INGEST_FULL=1 TMDB_INGEST_TYPE=series TMDB_INGEST_ORIGINAL_LANGUAGE=es node scripts/ingest-tmdb.mjs",
    "ingest:tvmaze": "node scripts/ingest-tvmaze.mjs",
    "ingest:tvmaze:full": "cross-env TVMAZE_FULL=1 node scripts/ingest-tvmaze.mjs",
