# Copia este archivo a .env.local y rellena los valores. Nunca subas valores reales.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CAFECITO_USERNAME=

# --- Catálogo ---
# neon | firebase | tmdb | demo  (sin nada configurado se usa "demo", datos en memoria)
CATALOG_PROVIDER=neon
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# PG_MAX_CONNECTIONS=5

# --- Tráilers y metadatos (TMDB) ---
# API Key v3 o Read Access Token v4: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Opcional
OMDB_API_KEY=

# --- Búsqueda con IA ---
DEEPSEEK_API_KEY=

# --- Firebase (cliente: auth + favoritos) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin (servidor). Ver docs/FIREBASE_SERVICE_ACCOUNT.md ---
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Chat ---
CHAT_PROVIDER=neon
CHAT_MODERATION_SECRET=
CHAT_ADMIN_UIDS=

# --- Ingesta (POST /api/ingest/tmdb, cabecera x-api-key) ---
INGEST_SECRET_KEY=
