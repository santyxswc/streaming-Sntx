# Copia a .env o .env.local (Vite) y rellena. No subas valores reales.
# La API de la app web debe ser accesible desde el cliente (CORS/HTTPS según despliegue).

# URL base del backend Next.js (rutas /api/...). En desarrollo, suele ser el mismo origen o tu tunnel.
VITE_API_URL=http://localhost:3000

# Mismo proyecto Firebase que la app web (prefijo VITE_ para Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
